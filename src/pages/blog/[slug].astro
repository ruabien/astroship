---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/container.astro';

export const prerender = false;

const { slug } = Astro.params;

// Hàm chuẩn hóa chuỗi sạch để so sánh chính xác tuyệt đối, né lỗi ký tự ẩn
function sanitizeSlug(text: string) {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // Khử dấu tiếng Việt phát sinh
    .replace(/[^a-z0-9-]/g, '')     // Chỉ giữ lại chữ thường, số và dấu gạch ngang
    .trim();
}

const currentSlug = sanitizeSlug(slug || "");

let title = "";
let description = "";
let image = "";
let date = "";
let author = "";
let Content: any = null;
let hasError = false;

try {
  // Quét toàn bộ các file bài viết Markdown (.md) trong thư mục blog
  const posts = import.meta.glob('/src/content/blog/*.md', { eager: true });
  let matchedFile: any = null;

  // Vòng lặp tìm kiếm thông minh, tránh lệch pha ký tự hoa thường hay khoảng trắng
  for (const path in posts) {
    const fileSlug = path.split('/').pop()?.replace('.md', '') || "";
    if (sanitizeSlug(fileSlug) === currentSlug) {
      matchedFile = posts[path];
      break;
    }
  }

  if (matchedFile) {
    title = matchedFile.frontmatter.title || "Bài viết không tiêu đề";
    description = matchedFile.frontmatter.description || "";
    image = matchedFile.frontmatter.image || "";
    date = matchedFile.frontmatter.publishDate || matchedFile.frontmatter.date || "";
    author = matchedFile.frontmatter.author || "Quản trị viên";
    
    // Lấy hàm render nội dung bài viết dạng HTML
    Content = matchedFile.Content;
  } else {
    hasError = true;
  }
} catch (e) {
  hasError = true;
}

// Nếu không tìm thấy bài viết hoặc code lỗi, chuyển hướng êm đẹp về trang 404
if (hasError || !Content) {
  return Astro.redirect('/404');
}
---

<Layout title={title}>
  <Container>
    <div class="max-w-3xl mx-auto my-10 px-4">
      {/* 1. Phần Chân trang tiêu đề: Ngày tháng, Tác giả */}
      <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-4 leading-tight">
          {title}
        </h1>
        <div class="flex items-center justify-center gap-4 text-sm text-gray-500">
          <span>✍️ {author}</span>
          {date && (
            <>
              <span>•</span>
              <span>📅 {new Date(date).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </>
          )}
        </div>
      </div>

      {/* 2. Ảnh bìa bài viết lớn tràn viền */}
      {image && (
        <div class="mb-10 aspect-[16/9] overflow-hidden rounded-xl shadow-md">
          <img src={image} alt={title} class="w-full h-full object-cover" />
        </div>
      )}

      {/* 3. KHỐI NỘI DUNG CHI TIẾT BÀI VIẾT (Sử dụng CSS Class sạch, không dùng @apply lỗi của Tailwind v4) */}
      <article class="blog-markdown-content max-w-none text-gray-800 leading-relaxed mx-auto">
        <Content />
      </article>

      {/* 4. Nút quay lại danh sách Blog */}
      <div class="text-center border-t pt-8 mt-12 border-gray-100">
        <a 
          href="/blog" 
          class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold transition-colors"
        >
          ← Quay lại danh sách bài viết
        </a>
      </div>
    </div>
  </Container>
</Layout>

<style is:global>
  /* GIẢI PHÁP ĐẶC TRỊ TAILWIND V4: Sử dụng CSS thuần 100% để bộ biên dịch Vite chạy mượt mà, không bao giờ lỗi */
  .blog-markdown-content h2 {
    font-size: 1.5rem; /* Tương đương text-2xl */
    font-weight: 700;    /* Tương đương font-bold */
    color: #111827;      /* Tương đương text-gray-900 */
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .blog-markdown-content h3 {
    font-size: 1.25rem; /* Tương đương text-xl */
    font-weight: 700;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .blog-markdown-content p {
    margin-bottom: 1.25rem;
    color: #374151;      /* Tương đương text-gray-700 */
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .blog-markdown-content ul {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 1.25rem;
    padding-left: 1rem;
  }
  .blog-markdown-content ol {
    list-style-type: decimal;
    list-style-position: inside;
    margin-bottom: 1.25rem;
    padding-left: 1rem;
  }
  .blog-markdown-content img {
    border-radius: 0.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    max-width: 100%;
    height: auto;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }
</style>
