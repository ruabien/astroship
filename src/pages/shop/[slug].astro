---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/container.astro';

// Tắt prerender để chạy chế độ động trên Cloudflare Server
export const prerender = false;

const { slug } = Astro.params;

let title = "";
let price = 0;
let description = "";
let image = "";
let hasError = false;

try {
  // Sử dụng Vite để quét và đọc trực tiếp file markdown trong thư mục content
  const posts = import.meta.glob('/src/content/ebooks/*.md', { eager: true });
  
  // Tìm file có tên khớp với slug người dùng đang truy cập
  const matchPath = `/src/content/ebooks/${slug}.md`;
  const matchedFile = posts[matchPath] as any;

  if (matchedFile) {
    title = matchedFile.frontmatter.title || "Ebook";
    price = matchedFile.frontmatter.price || 0;
    description = matchedFile.frontmatter.description || "";
    image = matchedFile.frontmatter.image || "";
  } else {
    hasError = true;
  }
} catch (e) {
  hasError = true;
}

// Nếu không tìm thấy sản phẩm, chuyển hướng văn minh về trang 404
if (hasError) {
  return Astro.redirect('/404');
}
---

<Layout title={title}>
  <Container>
    <div class="max-w-4xl mx-auto my-10 grid md:grid-cols-2 gap-8 items-center">
      <div>
        {image && <img src={image} alt={title} class="w-full rounded-lg shadow-xl border" />}
      </div>
      
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">{title}</h1>
        <p class="text-2xl font-extrabold text-blue-600 mb-4">{price.toLocaleString('vi-VN')} VNĐ</p>
        <div class="text-gray-600 mb-6 border-b pb-6">{description}</div>
        
        <button 
          id="btn-payos-buy" 
          data-price={price} 
          data-title={title}
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-200 cursor-pointer text-center"
        >
          Mua Ngay Với Mã QR
        </button>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const buyButton = document.getElementById('btn-payos-buy');
  buyButton?.addEventListener('click', async () => {
    buyButton.innerText = "Đang khởi tạo mã QR...";
    buyButton.setAttribute('disabled', 'true');
    const price = buyButton.getAttribute('data-price');
    const title = buyButton.getAttribute('data-title');

    try {
      const response = await fetch('/api/create-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ price: Number(price), title })
      });
      const data = await response.json();
      if (data.checkoutUrl) {
        window.location.href = data.checkoutUrl;
      } else {
        alert('Lỗi tạo link thanh toán!');
        if(buyButton) { buyButton.innerText = "Mua Ngay Với Mã QR"; buyButton.removeAttribute('disabled'); }
      }
    } catch {
      alert('Lỗi kết nối hệ thống!');
    }
  });
</script>
