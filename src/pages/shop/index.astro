---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/container.astro';

export const prerender = false;

let products: any[] = [];
let hasError = false;

try {
  const posts = import.meta.glob('/src/content/ebooks/*.md', { eager: true });
  
  for (const path in posts) {
    const file: any = posts[path];
    const slug = path.split('/').pop()?.replace('.md', '') || "";
    
    products.push({
      slug: slug,
      title: file.frontmatter.title || "Ebook không tên",
      price: file.frontmatter.price || 0,
      oldPrice: file.frontmatter.oldPrice || 0,
      category: file.frontmatter.category || "HoTroOnline", // Bốc tách danh mục
      image: file.frontmatter.image || "",
    });
  }
} catch (e) {
  hasError = true;
}
---

<Layout title="Cửa hàng Ebook - HoTro.Online">
  <Container>
    <div class="my-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-2">Tủ Sách Ebook Công Nghệ</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Học tập và làm chủ công nghệ dẫn đầu xu hướng.</p>
    </div>

    {hasError || products.length === 0 ? (
      <div class="text-center py-20 border rounded-xl bg-gray-50">
        <p class="text-gray-500 text-lg">Hiện chưa có sản phẩm nào được đăng tải. Vui lòng quay lại sau!</p>
      </div>
    ) : (
      /* Bộ khung lưới Grid 3 cột sang trọng */
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 my-12">
        {products.map((product) => (
          <a 
            href={`/shop/${product.slug}`}
            class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-xl hover:border-blue-500 transition-all duration-300 overflow-hidden flex flex-col group cursor-pointer"
          >
            {/* 1. Phần HÌNH ẢNH Ở PHÍA TRÊN */}
            <div class="aspect-[4/3] bg-gray-50 overflow-hidden relative border-b border-gray-100">
              {product.image ? (
                <img 
                  src={product.image} 
                  alt={product.title} 
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  Hình ảnh đang cập nhật
                </div>
              )}
            </div>

            {/* Khối nội dung phía dưới */}
            <div class="p-5 flex flex-col justify-between flex-1 bg-white">
              <div>
                {/* 2. TIÊU ĐỀ SẢN PHẨM ĐẦY ĐỦ */}
                <h2 class="text-[17px] font-semibold text-gray-800 group-hover:text-blue-600 transition-colors leading-snug mb-3">
                  {product.title}
                </h2>
                
                {/* 3. PHẦN CATEGORY (Hiển thị icon nhỏ kèm chữ như ảnh mẫu) */}
                <div class="flex items-center gap-2 mb-4">
                  <div class="w-5 h-5 rounded-md bg-blue-50 flex items-center justify-center text-[10px] text-blue-600 font-bold border border-blue-100">
                    📚
                  </div>
                  <span class="text-xs font-medium text-gray-500">
                    {product.category}
                  </span>
                </div>
              </div>

              {/* 4. PHẦN GIÁ CẢ CĂN TRÁI THEO ĐÚNG MẪU MỚI */}
              <div class="flex items-baseline gap-2 border-t pt-4 border-gray-50 justify-start">
                {product.oldPrice > 0 && (
                  <span class="text-sm text-gray-400 line-through font-normal">
                    {product.oldPrice.toLocaleString('vi-VN')} đ
                  </span>
                )}
                <span class="text-base font-bold text-red-500">
                  {product.price.toLocaleString('vi-VN')} đ
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </Container>
</Layout>
