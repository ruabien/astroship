---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/container.astro';

export const prerender = false;

let products: any[] = [];
let hasError = false;

try {
  // Quét toàn bộ file markdown chứa thông tin sách trong thư mục ebooks
  const posts = import.meta.glob('/src/content/ebooks/*.md', { eager: true });
  
  // Duyệt qua từng file và bốc tách dữ liệu cấu trúc frontmatter
  for (const path in posts) {
    const file: any = posts[path];
    const slug = path.split('/').pop()?.replace('.md', '') || "";
    
    products.push({
      slug: slug,
      title: file.frontmatter.title || "Ebook không tên",
      price: file.frontmatter.price || 0,
      description: file.frontmatter.description || "Chưa có mô tả cho sản phẩm này.",
      image: file.frontmatter.image || "",
    });
  }
} catch (e) {
  hasError = true;
}
---

<Layout title="Cửa hàng Ebook - HoTro.Online">
  <Container>
    <div class="my-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-2">Tủ Sách Ebook Công Nghệ</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Khám phá kho tri thức tự động hóa, tài liệu lập trình chất lượng cao được cập nhật liên tục.</p>
    </div>

    {hasError || products.length === 0 ? (
      <div class="text-center py-20 border rounded-xl bg-gray-50">
        <p class="text-gray-500 text-lg">Hiện chưa có sản phẩm nào được đăng tải. Vui lòng quay lại sau!</p>
      </div>
    ) : (
      /* Giao diện lưới Grid 3 cột tự động co giãn theo kích thước màn hình chuẩn WooCommerce */
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 my-12">
        {products.map((product) => (
          <div class="bg-white border rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-column overflow-hidden group">
            {/* Khối hiển thị hình ảnh sản phẩm */}
            <div class="aspect-square bg-gray-100 overflow-hidden relative border-b w-full">
              {product.image ? (
                <img 
                  src={product.image} 
                  alt={product.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  Không có hình ảnh
                </div>
              )}
            </div>

            {/* Khối hiển thị thông tin chi tiết */}
            <div class="p-6 flex flex-col justify-between flex-1">
              <div>
                <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-1 mb-2">
                  {product.title}
                </h2>
                
                {/* Mô tả ngắn của Ebook */}
                <p class="text-gray-600 text-sm line-clamp-2 mb-4">
                  {product.description}
                </p>
              </div>

              <div>
                {/* Giá cả định dạng chuẩn Việt Nam */}
                <div class="flex items-center justify-between mt-2 border-t pt-4">
                  <span class="text-lg font-extrabold text-blue-600">
                    {product.price.toLocaleString('vi-VN')} VNĐ
                  </span>
                  
                  {/* Nút Xem Thêm dẫn thẳng sang trang chi tiết [slug].astro */}
                  <a 
                    href={`/shop/${product.slug}`}
                    class="bg-gray-100 hover:bg-blue-600 hover:text-white text-gray-700 font-semibold py-2 px-4 rounded-lg text-sm transition-colors duration-200"
                  >
                    Xem thêm
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </Container>
</Layout>
