---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

// CẤU HÌNH MENU MỚI: Tinh gọn, tích hợp Dropdown danh mục Blog theo yêu cầu
const menuitems = [
  {
    title: "Trang chủ",
    path: "/",
  },
  {
    title: "Thư viện AI",
    path: "/shop",
  },
  {
    title: "Góc Kiểm Sát",
    path: "/blog",
    // Kích hoạt nút Dropdown con chứa 4 chuyên mục cốt lõi
    children: [
      { title: "AI Kiểm Sát", path: "/blog/category/ai-kiem-sat" },
      { title: "Prompt Pháp Lý", path: "/blog/category/prompt-phap-ly" },
      { title: "Pháp Luật Số", path: "/blog/category/phap-luat-so" },
      { title: "Nhật Ký Kiểm Sát", path: "/blog/category/nhat-ky-nghe" },
    ],
  },
  {
    title: "Về tôi",
    path: "/about",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        {/* Đổi tên Logo thương hiệu sang HoTro.Online sắc nét */}
        <a href="/" class="text-lg font-extrabold text-blue-600 tracking-tight">
          HoTro<span class="text-gray-800">.Online</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900 font-medium transition-colors"
                    >
                      <span> {item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
    <div>
      {/* Đã lược bỏ toàn bộ các khối nút "Log in / Sign up" dư thừa của template gốc 
        để trả lại không gian thoáng đãng, sang trọng chuẩn website chuyên gia.
      */}
    </div>
  </header>
</Container>
